{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "center": {
      "default": [
        0,
        0,
        0
      ],
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "depends_on": {
      "default": [],
      "items": {
        "maxLength": 96,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "maxLength": 96,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
      "type": "string"
    },
    "op": {
      "const": "primitive.box"
    },
    "size": {
      "items": {
        "oneOf": [
          {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          {
            "additionalProperties": false,
            "properties": {
              "id": {
                "maxLength": 96,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
                "type": "string"
              },
              "kind": {
                "const": "dimension_ref"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "type": "object"
          }
        ]
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    }
  },
  "required": [
    "id",
    "op",
    "size"
  ],
  "title": "Hard Surface Workbench primitive.box 1.0",
  "type": "object"
}
