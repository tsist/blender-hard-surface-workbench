{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chord_tolerance": {
      "default": 0.01,
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "depends_on": {
      "default": [],
      "items": {
        "maxLength": 96,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "depth": {
      "oneOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 96,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
              "type": "string"
            },
            "kind": {
              "const": "dimension_ref"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "id": {
      "maxLength": 96,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
      "type": "string"
    },
    "mode": {
      "default": "mesh_apply",
      "enum": [
        "mesh_apply"
      ],
      "type": "string"
    },
    "op": {
      "const": "profile.extrude"
    },
    "profile": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sketch_profile"
            },
            "profile_id": {
              "maxLength": 96,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
              "type": "string"
            },
            "sketch_id": {
              "maxLength": 96,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sketch_id",
            "profile_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "step_output"
            },
            "port": {
              "maxLength": 96,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
              "type": "string"
            },
            "step_id": {
              "maxLength": 96,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "step_id",
            "port"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "feature_id": {
              "maxLength": 96,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
              "type": "string"
            },
            "kind": {
              "const": "feature_ref"
            },
            "port": {
              "maxLength": 96,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "feature_id",
            "port"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "id",
    "op",
    "profile",
    "depth"
  ],
  "title": "Hard Surface Workbench profile.extrude 1.0",
  "type": "object"
}
