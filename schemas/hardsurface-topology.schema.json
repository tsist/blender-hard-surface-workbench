{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "const": "hardsurface.topology"
    },
    "params": {
      "additionalProperties": false,
      "not": {
        "required": [
          "feature_ids",
          "object_ids"
        ]
      },
      "properties": {
        "cpu_threads": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        },
        "export_geometry": {
          "default": false,
          "type": "boolean"
        },
        "feature_ids": {
          "items": {
            "maxLength": 96,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "mesh_states": {
          "default": [
            "control",
            "evaluated"
          ],
          "items": {
            "enum": [
              "control",
              "evaluated"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "object_ids": {
          "items": {
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        "self_intersections": {
          "default": false,
          "type": "boolean"
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "expected_sha256": {
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "file": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "file",
            "expected_sha256"
          ],
          "type": "object"
        },
        "wall_seconds": {
          "default": 600,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "type": "number"
        }
      },
      "required": [
        "request_id",
        "source"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "schema_version",
    "command",
    "params"
  ],
  "title": "Hard Surface Workbench read-only topology 1.0",
  "type": "object"
}
