{
  "schema_version": "1.0",
  "command": "hardsurface.run",
  "params": {
    "manifest_version": "1.0",
    "request_id": "native-revolve-final",
    "purpose": "contract_fixture",
    "source": {
      "kind": "new_scene",
      "project_id": "native_revolve_fixture",
      "length_unit": "mm",
      "up_axis": "Z"
    },
    "context": {
      "scene": "Fixture",
      "view_layer": "ViewLayer",
      "frame": 1,
      "evaluation": "RENDER"
    },
    "resources": [],
    "design": {
      "mode": "create_if_absent",
      "expected_state": "absent",
      "state": {
        "revision": 1,
        "dimensions": [
          {
            "id": "width",
            "role": "driving",
            "quantity": "length",
            "value": 10,
            "unit": "mm"
          },
          {
            "id": "height",
            "role": "driving",
            "quantity": "length",
            "value": 30,
            "unit": "mm"
          }
        ],
        "sketches": [
          {
            "id": "revolve_rectangle",
            "workplane": {
              "kind": "datum",
              "id": "world_xy"
            },
            "entities": [
              {
                "id": "p0",
                "kind": "point2d",
                "seed": [
                  0.1,
                  0.1
                ]
              },
              {
                "id": "p1",
                "kind": "point2d",
                "seed": [
                  77,
                  0.2
                ]
              },
              {
                "id": "p2",
                "kind": "point2d",
                "seed": [
                  78,
                  48
                ]
              },
              {
                "id": "p3",
                "kind": "point2d",
                "seed": [
                  0.2,
                  49
                ]
              },
              {
                "id": "l0",
                "kind": "line_segment2d",
                "start": "p0",
                "end": "p1"
              },
              {
                "id": "l1",
                "kind": "line_segment2d",
                "start": "p1",
                "end": "p2"
              },
              {
                "id": "l2",
                "kind": "line_segment2d",
                "start": "p2",
                "end": "p3"
              },
              {
                "id": "l3",
                "kind": "line_segment2d",
                "start": "p3",
                "end": "p0"
              }
            ],
            "constraints": [
              {
                "id": "anchor",
                "type": "point_fixed2d",
                "point": "p0",
                "at": [
                  10,
                  0
                ]
              },
              {
                "id": "h0",
                "type": "horizontal",
                "line": "l0"
              },
              {
                "id": "h2",
                "type": "horizontal",
                "line": "l2"
              },
              {
                "id": "v1",
                "type": "vertical",
                "line": "l1"
              },
              {
                "id": "v3",
                "type": "vertical",
                "line": "l3"
              },
              {
                "id": "w",
                "type": "axis_distance2d",
                "from": "p0",
                "to": "p1",
                "axis": "X",
                "dimension": "width"
              },
              {
                "id": "h",
                "type": "axis_distance2d",
                "from": "p0",
                "to": "p3",
                "axis": "Y",
                "dimension": "height"
              }
            ],
            "profiles": [
              {
                "id": "section",
                "outer": [
                  "l0",
                  "l1",
                  "l2",
                  "l3"
                ]
              }
            ],
            "solve": {
              "underconstrained": "reject",
              "redundant_solved": "report_and_verify",
              "branch_policy": "preserve_declared",
              "max_attempts": 1,
              "allowed_strategies": [
                "declared_seed"
              ],
              "verification": {
                "length_tolerance_mm": 0.001,
                "angle_tolerance_deg": 0.001
              },
              "diagnostics": {
                "when": "failure_or_redundancy",
                "max_seconds": 5
              }
            }
          }
        ],
        "features": [
          {
            "id": "revolved",
            "program": {
              "kind": "steps",
              "steps": [
                {
                  "id": "solve",
                  "op": "sketch.solve",
                  "sketch_id": "revolve_rectangle"
                },
                {
                  "id": "body",
                  "op": "profile.revolve",
                  "profile": {
                    "kind": "step_output",
                    "step_id": "solve",
                    "port": "section"
                  },
                  "axis": "Z",
                  "angle": 360,
                  "segments": 128,
                  "chord_tolerance": 0.01
                }
              ]
            }
          }
        ]
      }
    },
    "protection": {
      "source_write": "forbidden",
      "shared_data": "reject_shared",
      "manual_edits": "preserve_supported_nonconflicting",
      "on_conflict": "pause"
    },
    "work_units": [
      {
        "id": "build",
        "feature_ids": [
          "revolved"
        ],
        "checks": [
          "design_dimensions",
          "closed_mesh",
          "source_preserved",
          "reopen"
        ],
        "failure_policy": "stop_job"
      }
    ],
    "quality": {
      "profile": "static_closed_mechanical_fixture",
      "required": [
        "constraint_residuals",
        "profile_validity",
        "design_dimensions",
        "closed_mesh",
        "preservation",
        "reopen",
        "dependencies"
      ],
      "visual": "not_applicable_fixture_only",
      "user_feedback": "not_applicable_fixture_only"
    },
    "budgets": {
      "max_total_steps": 32,
      "max_geometry_vertices": 200000,
      "max_geometry_loops": 1000000,
      "wall_seconds": 180,
      "cpu_threads": 2
    },
    "output": {
      "publication": "candidate_only",
      "report": "compact"
    },
    "wire": {
      "enabled": false
    }
  }
}
